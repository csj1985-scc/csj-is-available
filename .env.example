# ============================================================
# 悟道 (Wudao) 环境配置
# ============================================================
# 使用方式：
#   1. 复制本文件为 .env
#   2. 填入你的 API Key
#   3. 运行 start.sh (Linux/Mac) 或 start.bat (Windows)
#
# cp .env.example .env
# ============================================================

# ── LLM API 配置（至少填一个） ──────────────────────────

# 【推荐】DeepSeek API Key（主要模型，效果好）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 【备选】智谱 GLM API Key（当 DeepSeek 不可用时自动切换）
# 申请地址：https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=your_glm_api_key_here

# ── 服务配置 ────────────────────────────────────────────

# 服务端口（默认 8002，可修改）
PORT=8002

# 数据存储目录（默认 ./data）
WUDAO_DATA=./data

# ── 管理配置 ────────────────────────────────────────────

# 管理面板 Token（用于访问管理接口）
ADMIN_TOKEN=wudao-admin-2024

# ── 通知配置（可选） ────────────────────────────────────

# 企业微信机器人 Webhook（告警通知）
WECHAT_WEBHOOK=

# 飞书机器人 Webhook
FEISHU_WEBHOOK=

# ── 余额配置（可选） ────────────────────────────────────

# 从 DeepSeek 平台查到的充值余额（元）
WUDAO_BALANCE=0
